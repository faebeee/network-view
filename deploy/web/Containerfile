# Frontend: static React build served by Caddy. Sits behind the reverse proxy.
ARG NODE_IMAGE=docker.io/library/node:24-trixie-slim
ARG CADDY_IMAGE=docker.io/library/caddy:2.10-alpine
ARG TURBO_VERSION=2.11.13

# 1. Reduce the monorepo to the frontend and the packages it depends on.
FROM ${NODE_IMAGE} AS prune
ARG TURBO_VERSION
WORKDIR /repo
RUN npm install --global turbo@${TURBO_VERSION}
COPY . .
RUN turbo prune @network-view/frontend --docker

# 2. Install dependencies and build.
FROM ${NODE_IMAGE} AS build
WORKDIR /repo
COPY --from=prune /repo/out/json/ .
RUN npm ci
COPY --from=prune /repo/out/full/ .
RUN npx turbo run build --filter=@network-view/frontend

# 3. Runtime: Caddy as an unprivileged static file server.
FROM ${CADDY_IMAGE} AS runtime
RUN chown -R nobody:nobody /config /data
COPY deploy/web/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/apps/frontend/dist /srv

EXPOSE 3200
USER nobody

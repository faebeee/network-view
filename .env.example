# Copy to .env and adjust. Read by `podman compose`.

# Host port of the reverse proxy (the URL you open in the browser).
PROXY_PORT=8080
# Host address the proxy port is published on. 0.0.0.0 = reachable from the LAN, 127.0.0.1 = this machine only.
PROXY_BIND=0.0.0.0

# Internal port of the API. It listens on EDGE_GATEWAY and is only reachable through the proxy.
API_PORT=3100
# Bridge network shared by proxy and web. Change it if it overlaps with an existing network.
EDGE_SUBNET=10.89.40.0/24
EDGE_GATEWAY=10.89.40.1
